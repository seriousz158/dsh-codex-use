{
  "name": "dsh-codex-search",
  "version": "0.1.0",
  "description": "Explicit, opt-in Codex search provider for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./remote-search": "./lib/remote-search.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "build": "node --check lib/index.js && node --check lib/remote-search.js",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "files": ["README.md", "lib", "cordis.patch.yml"],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.7 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seriousz158/dsh-codex-use.git",
    "directory": "packages/dsh-codex-search"
  }
}

{
  "name": "dsh-codex-appserver",
  "version": "0.2.2",
  "private": true,
  "description": "OpenAI Codex ChatGPT App Server provider for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "scripts": {
    "build": "node --check lib/index.js && node --check lib/client.js && node --check lib/adapter.js && node --check lib/rpc.js && node --check lib/compatibility.js && node --check lib/diagnostics.js && node --check lib/errors.js",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./compatibility.json": "./compatibility.json",
    "./protocol": "./lib/protocol.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "README.md",
    "lib",
    "compatibility.json",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7 <0.2.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.7 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.7 <0.2.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.7 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seriousz158/dsh-codex-use.git",
    "directory": "packages/dsh-codex-appserver"
  },
  "homepage": "https://github.com/seriousz158/dsh-codex-use"
}

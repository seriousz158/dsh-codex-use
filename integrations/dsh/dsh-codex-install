#!/bin/zsh
set -euo pipefail

# Install the standalone plugin into an existing DSH_HOME without copying the
# host runtime, credentials, sessions, or stored memory into this repository.
REPO_DIR="$(cd -- "$(dirname -- "$0")/../.." && pwd -P)"
DSH_HOME_VALUE="${DSH_HOME:-$HOME/.dsh}"
PACKAGE_DIR="$REPO_DIR/packages/dsh-codex-appserver"
PROFILE_NODE_MODULES="$DSH_HOME_VALUE/profiles/node_modules"
PROFILE_LINK="$PROFILE_NODE_MODULES/dsh-codex-appserver"
PACKAGE_LINK="$PACKAGE_DIR/node_modules"
PACKAGE_NODE_MODULES_TARGET="$PROFILE_NODE_MODULES"
HOST_PATCH="$DSH_HOME_VALUE/cordis.patch.yml"
WEB_PATCH="$DSH_HOME_VALUE/profiles/web/cordis.patch.yml"
LEGACY_ID="codex-appserver"
MANUAL_ID="codex-appserver-manual"

DUPLICATE_GUARD="[...ctx.loader.entries()].some((e) => e.options.name === 'dsh-codex-appserver' && !e.disabled)"

die() {
  print -u2 -- "dsh-codex-install: $*"
  exit 1
}

[[ "$DSH_HOME_VALUE" = /* ]] || die "DSH_HOME must be an absolute path: $DSH_HOME_VALUE"
[[ -f "$PACKAGE_DIR/package.json" ]] || die "plugin package is missing: $PACKAGE_DIR"

mkdir -p "$PROFILE_NODE_MODULES"

if [[ -e "$HOST_PATCH" && ! -f "$HOST_PATCH" ]]; then
  die "shared host patch is not a regular file: $HOST_PATCH"
fi
if [[ ! -e "$HOST_PATCH" ]]; then
  umask 077
  print -r -- '[]' > "$HOST_PATCH"
fi

ensure_link() {
  local link="$1"
  local target="$2"
  local expected actual
  expected="$(cd -P -- "$target" && pwd -P)" || die "target does not resolve: $target"
  if [[ -L "$link" ]]; then
    actual="$(cd -P -- "$link" && pwd -P)" || die "link target does not resolve: $link"
    [[ "$actual" == "$expected" ]] || die "refusing to replace unexpected link: $link -> $actual"
    return
  fi
  [[ ! -e "$link" ]] || die "refusing to replace existing path: $link"
  ln -s "$target" "$link"
}

registration_count() {
  local patch="$1"
  local needle="$2"
  if [[ "$needle" == id:\ * ]]; then
    grep -Ec -- "^[[:space:]-]*${needle}$" "$patch" || true
  else
    grep -Fc -- "$needle" "$patch" || true
  fi
}

migrate_legacy_registration() {
  local temporary backup
  backup="$(mktemp "${HOST_PATCH}.bak.XXXXXX")"
  chmod 600 "$backup"
  cp -- "$HOST_PATCH" "$backup"
  temporary="$(mktemp "${HOST_PATCH}.migration.XXXXXX")"
  chmod 600 "$temporary"
  HOST_PATCH="$HOST_PATCH" TEMPORARY="$temporary" python3 - <<'PY'
from pathlib import Path
import os

path = Path(os.environ["HOST_PATCH"])
temporary = Path(os.environ["TEMPORARY"])
text = path.read_text()
old = "- insert:\n    - id: codex-appserver\n      name: dsh-codex-appserver"
new = "- insert:\n    - id: codex-appserver-manual\n      name: dsh-codex-appserver\n      disabled: !!js \"[...ctx.loader.entries()].some((e) => e.options.name === 'dsh-codex-appserver' && !e.disabled)\""
if text.count(old) != 1:
    raise SystemExit("legacy registration is not the exact migration shape")
temporary.write_text(text.replace(old, new, 1))
PY
  mv "$temporary" "$HOST_PATCH"
  print "Migrated legacy $LEGACY_ID registration to $MANUAL_ID"
  print "Backup: $backup"
}

append_host_registration() {
  local temporary
  temporary="$(mktemp "${HOST_PATCH}.tmp.XXXXXX")"
  {
    cat "$HOST_PATCH"
    print ''
    print -r -- '- insert:'
    print "    - id: $MANUAL_ID"
    print '      name: dsh-codex-appserver'
    print -r -- "      disabled: !!js \"$DUPLICATE_GUARD\""
  } > "$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$HOST_PATCH"
}

ensure_link "$PROFILE_LINK" "$PACKAGE_DIR"
if [[ -L "$PACKAGE_LINK" ]]; then
  package_link_actual="$(cd -P -- "$PACKAGE_LINK" && pwd -P)" || die "link target does not resolve: $PACKAGE_LINK"
  package_link_expected="$(cd -P -- "$PACKAGE_NODE_MODULES_TARGET" && pwd -P)" || die "target does not resolve: $PACKAGE_NODE_MODULES_TARGET"
  if [[ "$package_link_actual" != "$package_link_expected" ]]; then
    [[ "$package_link_actual" == */profiles/node_modules ]] || die "refusing to replace unexpected package dependency link: $PACKAGE_LINK -> $package_link_actual"
    ln -sfn "$PACKAGE_NODE_MODULES_TARGET" "$PACKAGE_LINK"
  fi
else
  ensure_link "$PACKAGE_LINK" "$PACKAGE_NODE_MODULES_TARGET"
fi

legacy_ids="$(registration_count "$HOST_PATCH" "id: $LEGACY_ID")"
legacy_names="$(registration_count "$HOST_PATCH" 'name: dsh-codex-appserver')"
if (( legacy_ids > 0 )); then
  if (( legacy_ids != 1 || legacy_names < 1 )); then
    die "legacy codex-appserver registration is incomplete; edit $HOST_PATCH before retrying"
  fi
  migrate_legacy_registration
fi

manual_ids="$(registration_count "$HOST_PATCH" "id: $MANUAL_ID")"
manual_names="$(registration_count "$HOST_PATCH" 'name: dsh-codex-appserver')"
web_ids=0
web_names=0
if [[ -f "$WEB_PATCH" ]]; then
  web_ids="$(registration_count "$WEB_PATCH" "id: $LEGACY_ID")"
  web_ids=$(( web_ids + $(registration_count "$WEB_PATCH" "id: $MANUAL_ID") ))
  web_names="$(registration_count "$WEB_PATCH" 'name: dsh-codex-appserver')"
fi

if (( manual_ids > 1 || manual_names > 1 || web_ids > 0 || web_names > 0 )); then
  die "duplicate codex-appserver registration; keep only the bundle row or one shared-host row"
fi
if (( manual_ids == 1 && manual_names == 0 )) || (( manual_ids == 0 && manual_names == 1 )); then
  die "shared host patch has an incomplete codex-appserver registration"
fi

if (( manual_ids == 0 )); then
  append_host_registration
fi

print "dsh-codex-appserver installed from $REPO_DIR"
print "DSH_HOME=$DSH_HOME_VALUE"
print "Shared host registration: $HOST_PATCH"
print "Restart DSH to load the provider; select provider codex-chatgpt in the UI."
